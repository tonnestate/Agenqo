{
  "name": "Agenqo · Internal Review Outbox (safe MVP)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "10b70a35-74fa-4c90-a239-a5f26597728a",
      "name": "Poll every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-AGENQO-HOST/v1/integrations/n8n/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "id": "0c67f004-71a3-4f0c-a27e-3cc7659193c6",
      "name": "Claim one Agenqo event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "3e43b067-08d6-4760-a211-b174a0d95b93",
              "leftValue": "={{ $json.has_event }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "c43420c9-d02b-443e-8321-fda78c0e5f10",
      "name": "Event available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-AGENQO-HOST/v1/integrations/n8n/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $json.event.event_id, lease_token: $json.event.lease_token, execution_ref: \"n8n:\" + $execution.id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "46423635-921b-4277-9854-08ff50237850",
      "name": "Create internal review task and ACK",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Poll every minute": {
      "main": [
        [
          {
            "node": "Claim one Agenqo event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim one Agenqo event": {
      "main": [
        [
          {
            "node": "Event available?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Event available?": {
      "main": [
        [
          {
            "node": "Create internal review task and ACK",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
